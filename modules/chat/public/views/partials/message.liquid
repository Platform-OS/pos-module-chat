{% liquid
  assign message = message | markdown: '{ "elements": [ "br" ] }'
%}

<li class="pos-chat-message {% if authored %} pos-chat-message-authored {% endif %}">

  <time datetime="{{ created_at }}">
    {% if created_at %}
      {{ created_at | l: 'long', timezone }}
    {% endif %}
  </time>

  <div class="pos-chat-message-content">
    {{ message }}
  </div>

</li>
